  "html": "<h2 id=\"数据库操作\">数据库操作</h2>\n<pre><code class=\"hljs language-sql\"><span class=\"hljs-comment\">-- 查看所有数据库</span>\n<span class=\"hljs-keyword\">SHOW</span> DATABASES;\n\n<span class=\"hljs-comment\">-- 创建一个新数据库</span>\n<span class=\"hljs-keyword\">CREATE</span> DATABASE mytest <span class=\"hljs-keyword\">DEFAULT</span> <span class=\"hljs-keyword\">CHARACTER SET</span> utf8mb4;\n\n<span class=\"hljs-comment\">-- 使用这个数据库</span>\nUSE mytest;\n</code></pre><h2 id=\"表操作\">表操作</h2>\n<pre><code class=\"hljs language-sql\"><span class=\"hljs-comment\">-- 创建一张商品表</span>\n<span class=\"hljs-keyword\">CREATE TABLE</span> product (\n  id <span class=\"hljs-type\">BIGINT</span> <span class=\"hljs-keyword\">PRIMARY KEY</span> AUTO_INCREMENT,\n  name <span class=\"hljs-type\">VARCHAR</span>(<span class=\"hljs-number\">100</span>) <span class=\"hljs-keyword\">NOT NULL</span>,\n  price <span class=\"hljs-type\">DECIMAL</span>(<span class=\"hljs-number\">10</span>,<span class=\"hljs-number\">2</span>),\n  created_at DATETIME <span class=\"hljs-keyword\">DEFAULT</span> NOW()\n);\n</code></pre><h2 id=\"数据操作\">数据操作</h2>\n<pre><code class=\"hljs language-sql\"><span class=\"hljs-comment\">-- 插入一条数据</span>\n<span class=\"hljs-keyword\">INSERT INTO</span> product (name, price) <span class=\"hljs-keyword\">VALUES</span> (<span class=\"hljs-string\">&#x27;Spring Boot 入门课&#x27;</span>, <span class=\"hljs-number\">99.00</span>);\n\n<span class=\"hljs-comment\">-- 查询所有数据</span>\n<span class=\"hljs-keyword\">SELECT</span> <span class=\"hljs-operator\">*</span> <span class=\"hljs-keyword\">FROM</span> product;\n</code></pre>"
